# URL HTTP de la fonction Neon (vide = API même origine en local).
# En production, remplacer par l'URL générée par Neon Functions, sans ajouter /api.
VITE_MAPNIFIQUE_API_URL=

# Carte vectorielle gratuite (aucune clé API).
VITE_MAPNIFIQUE_MAP_ENGINE=maplibre
VITE_MAPNIFIQUE_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Option de repli Leaflet uniquement si VITE_MAPNIFIQUE_MAP_ENGINE=leaflet.
# Le service de tuiles OSM standard n'offre pas de SLA et possède une politique stricte.
VITE_MAPNIFIQUE_RASTER_TILE_URL=

# Optionnel : PMTiles auto-hébergé si un jour un stockage adapté est disponible.
VITE_MAPNIFIQUE_PMTILES_URL=
