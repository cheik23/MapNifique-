# Variables d'environnement — copiez ce fichier en `.env` (jamais commité).
# Sur Vercel : Project → Settings → Environment Variables, puis Redeploy.

# --- Awin (affiliation) : variables SERVEUR, lues par api/awin.js ---
# Jeton OAuth2 Awin (Bearer). NE JAMAIS exposer côté client.
AWIN_API_TOKEN=ton_token_ici
# Identifiant éditeur Awin (numérique), fixé côté serveur.
AWIN_PUBLISHER_ID=123456
# URL exacte de l'application (contrôle d'origine), ex. https://mapnifique.vercel.app
APP_ORIGIN=https://exemple.vercel.app
# Active la génération de liens Awin côté interface (laisser absent tant que
# l'affiliation n'est pas prête).
# VITE_AWIN_ENABLED=true

# --- Navitia (itinéraires multimodaux) ---
# ATTENTION : préfixe VITE_ = la clé est visible dans le bundle navigateur.
# À remplacer par un proxy serveur (api/navitia.js) avant toute vraie clé.
VITE_NAVITIA_API_KEY=ta_cle_ici
VITE_NAVITIA_COVERAGE=fr-idf
