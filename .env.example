# Variables d'environnement — copiez ce fichier en `.env` (jamais commité).
# Sur Vercel : Project → Settings → Environment Variables, puis Redeploy.

# Jeton OAuth2 Awin (Bearer) utilisé par api/awin.js. NE JAMAIS exposer côté client.
AWIN_API_TOKEN=ton_token_ici

# Navitia (itinéraires multimodaux) — https://navitia.io
# ATTENTION : préfixe VITE_ = la clé est visible dans le bundle navigateur.
VITE_NAVITIA_API_KEY=ta_cle_ici
VITE_NAVITIA_COVERAGE=fr-idf
