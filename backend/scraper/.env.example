# PostgreSQL: le service Docker Compose utilise ces valeurs par dÃ©faut.
POSTGRES_DB=mapnifique_scraper
POSTGRES_USER=mapnifique
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mapnifique:replace-with-a-long-random-password@db:5432/mapnifique_scraper

# Photon par défaut public pour le développement; définis cette URL si tu héberges Photon séparément.
PHOTON_URL=https://photon.komoot.io

# Les fichiers osm-pilot.lua et osm-sync.pgpass sont privés et restent hors Git.
# Active le profil osm-sync uniquement après les avoir placés ici ou configuré un dossier local.
MAPNIFIQUE_DATA_DIR=./data

# API Ã©coute Ã  l'intÃ©rieur du conteneur; Docker ne l'expose que sur le PC local.
HOST=0.0.0.0
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLACES_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# RÃ©glages de dÃ©part adaptÃ©s Ã  un PC modeste.
WORKER_POLL_MS=3000
WORKER_JOB_LEASE_MS=900000
WORKER_JOB_HEARTBEAT_MS=60000
WORKER_JOB_RETRY_DELAY_MS=300000
WORKER_JOB_MAX_ATTEMPTS=3
# Double opt-in obligatoire : demande d’activation ET validation écrite de conformité.
# Laisser les deux valeurs vides tant que les droits, robots.txt et limites ne sont pas validés.
OFFERS_ENABLED_SOURCES=
OFFERS_SOURCE_LICENSE_APPROVED=
DEFAULT_MAX_PAGES=100
HARD_MAX_PAGES=2000
DEFAULT_MAX_CONCURRENCY=2
DEFAULT_REQUESTS_PER_MINUTE=12
DEFAULT_SAME_DOMAIN_DELAY_SECS=2
